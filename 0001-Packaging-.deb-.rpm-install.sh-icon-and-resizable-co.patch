+++ b/.github/workflows/packages.yml
@@ -0,0 +1,167 @@
+# Lint and test, build the .deb and .rpm (architecture independent), install
+# them in clean containers, and publish a GitHub release for v* tags.
+name: Packages
+
+on:
+  push:
+    branches: [main]
+    tags: ["v*"]
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+env:
+  PACKAGE_MAINTAINER: ${{ vars.PACKAGE_MAINTAINER || 'RetroboxProject <retroboxproject@users.noreply.github.com>' }}
+
+jobs:
+  check:
+    name: Lint and tests
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+
+      - name: Qt runtime libraries
+        run: sudo apt-get update && sudo apt-get install -y --no-install-recommends libegl1 libgl1 libxkbcommon0 libfontconfig1 libdbus-1-3
+
+      - name: Install
+        run: pip install -e '.[gui,dev]'
+
+      - name: Tag matches __version__
+        if: startsWith(github.ref, 'refs/tags/v')
+        run: |
+          version="$(sed -n 's/^__version__ = "\(.*\)"$/\1/p' src/retroscrappy/__init__.py)"
+          if [[ "${GITHUB_REF_NAME#v}" != "${version}" ]]; then
+            echo "::error::Tag ${GITHUB_REF_NAME} does not match __version__ ${version}"
+            exit 1
+          fi
+
+      - name: pylint
+        run: pylint src/retroscrappy tests
+
+      - name: pytest
+        run: QT_QPA_PLATFORM=offscreen pytest -q
+
+      - name: shellcheck
+        run: shellcheck -x install.sh packaging/*.sh packaging/deb/postinst packaging/deb/prerm
+
+  build:
+    name: Build packages
+    needs: check
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Packaging tools
+        run: sudo apt-get update && sudo apt-get install -y --no-install-recommends rpm
+
+      - name: Build .deb
+        run: packaging/build-deb.sh
+
+      - name: Build .rpm
+        run: packaging/build-rpm.sh
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: packages
+          path: dist/*
+          if-no-files-found: error
+
+  test-deb:
+    name: Install on ${{ matrix.image }}
+    needs: build
+    runs-on: ubuntu-24.04
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - image: debian:trixie
+            required: true
+          # PySide6 is only packaged in Ubuntu releases newer than 24.04.
+          - image: ubuntu:rolling
+            required: false
+    container: ${{ matrix.image }}
+    continue-on-error: ${{ !matrix.required }}
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          name: packages
+          path: dist
+
+      - name: Install with apt
+        env:
+          DEBIAN_FRONTEND: noninteractive
+        run: |
+          apt-get update
+          apt-get install -y --no-install-recommends ./dist/*.deb
+
+      - name: Smoke test
+        run: |
+          retroscrappy --version
+          QT_QPA_PLATFORM=offscreen PYTHONPATH=/opt/retroscrappy/lib python3 -c \
+            "from PySide6.QtWidgets import QApplication; app = QApplication([]); \
+            from retroscrappy.gui.main_window import MainWindow; MainWindow()"
+          test -f /usr/share/applications/io.github.retroboxproject.retroscrappy.desktop
+          test -f /usr/share/icons/hicolor/scalable/apps/io.github.retroboxproject.retroscrappy.svg
+
+      - name: Remove cleanly
+        run: |
+          apt-get remove -y retroscrappy
+          test ! -e /opt/retroscrappy
+
+  test-rpm:
+    name: Install on fedora:latest
+    needs: build
+    runs-on: ubuntu-24.04
+    container: fedora:latest
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          name: packages
+          path: dist
+
+      - name: Install with dnf
+        run: dnf install -y --setopt=install_weak_deps=False ./dist/*.rpm
+
+      - name: Smoke test
+        run: |
+          retroscrappy --version
+          QT_QPA_PLATFORM=offscreen PYTHONPATH=/opt/retroscrappy/lib python3 -c \
+            "from PySide6.QtWidgets import QApplication; app = QApplication([]); \
+            from retroscrappy.gui.main_window import MainWindow; MainWindow()"
+          test -f /usr/share/applications/io.github.retroboxproject.retroscrappy.desktop
+
+      - name: Remove cleanly
+        run: |
+          dnf remove -y retroscrappy
+          test ! -e /opt/retroscrappy
+
+  release:
+    name: GitHub release
+    if: startsWith(github.ref, 'refs/tags/v')
+    needs: [test-deb, test-rpm]
+    runs-on: ubuntu-24.04
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          name: packages
+          path: dist
+
+      - name: Checksums
+        working-directory: dist
+        run: sha256sum ./*.deb ./*.rpm | sed 's| \./| |' > SHA256SUMS
+
+      - uses: softprops/action-gh-release@v2
+        with:
+          files: |
+            dist/*.deb
+            dist/*.rpm
+            dist/SHA256SUMS
+          generate_release_notes: true
