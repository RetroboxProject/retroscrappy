diff --git a/packaging/render-icons.sh b/packaging/render-icons.sh
new file mode 100755
index 0000000..0d0c180
--- /dev/null
+++ b/packaging/render-icons.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+# Render the PNG icon sizes (and the in-app window icon) from the SVG master.
+# Run after editing the SVG; the results are committed. Requires rsvg-convert
+# (librsvg2-bin on Debian, librsvg2-tools on Fedora).
+set -euo pipefail
+
+readonly APP_ID="io.github.retroboxproject.retroscrappy"
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+readonly ROOT
+readonly HICOLOR="${ROOT}/packaging/linux/icons/hicolor"
+readonly SVG="${HICOLOR}/scalable/apps/${APP_ID}.svg"
+readonly SIZES=(16 24 32 48 64 128 256 512)
+
+for size in "${SIZES[@]}"; do
+    dir="${HICOLOR}/${size}x${size}/apps"
+    mkdir -p "${dir}"
+    rsvg-convert --width "${size}" --height "${size}" "${SVG}" --output "${dir}/${APP_ID}.png"
+done
+cp "${HICOLOR}/256x256/apps/${APP_ID}.png" "${ROOT}/src/retroscrappy/data/icons/retroscrappy.png"
+echo "[ OK ] Icons rendered from ${SVG}"
diff --git a/packaging/rpm/retroscrappy.spec b/packaging/rpm/retroscrappy.spec
new file mode 100644
index 0000000..f784b3a
--- /dev/null
+++ b/packaging/rpm/retroscrappy.spec
@@ -0,0 +1,52 @@
+# Built by packaging/build-rpm.sh from a staged tree; not a source RPM.
+%global appid io.github.retroboxproject.retroscrappy
+%global prefix /opt/retroscrappy
+# Python files live in /opt: skip Fedora's automatic Python handling.
+%global __requires_exclude_from ^%{prefix}/.*$
+%global __provides_exclude_from ^%{prefix}/.*$
+%global __brp_python_bytecompile %{nil}
+%global __brp_mangle_shebangs %{nil}
+%global debug_package %{nil}
+
+Name:           retroscrappy
+Version:        %{pkg_version}
+Release:        %{pkg_release}
+Summary:        Metadata and artwork scraper for EmulationStation
+License:        GPL-3.0-only
+URL:            https://github.com/RetroboxProject/retroscrappy
+Packager:       %{pkg_packager}
+BuildArch:      noarch
+
+Requires:       python3 >= 3.11
+Requires:       python3-requests
+Requires:       python3-pyside6
+Recommends:     qt6-qtwayland
+
+%description
+Retroscrappy fills the gamelist.xml files of EmulationStation, as used by
+Batocera, RetroBat and Retrobox, with descriptions, box art, logos,
+screenshots and videos from ScreenScraper, SteamGridDB and IGDB.
+
+It provides a Qt graphical interface (retroscrappy-gui) and a command line
+tool (retroscrappy).
+
+%install
+cp -a %{stage_dir}/. %{buildroot}/
+install -Dm0644 %{license_file} %{buildroot}%{_datadir}/licenses/%{name}/LICENSE
+
+%post
+python3 -m compileall -q %{prefix}/lib > /dev/null 2>&1 || :
+
+%preun
+if [ "$1" -eq 0 ]; then
+    find %{prefix}/lib -type d -name __pycache__ -prune -exec rm -rf {} + 2> /dev/null || :
+fi
+
+%files
+%{prefix}
+%{_bindir}/%{name}
+%{_bindir}/%{name}-gui
+%{_datadir}/applications/%{appid}.desktop
+%{_datadir}/metainfo/%{appid}.metainfo.xml
+%{_datadir}/icons/hicolor/*/apps/%{appid}.*
+%{_datadir}/licenses/%{name}/LICENSE
