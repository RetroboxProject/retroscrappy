+#!/bin/sh
+# Remove the byte-code generated by postinst (not tracked by dpkg).
+set -e
+
+case "$1" in
+    remove | upgrade | deconfigure)
+        find /opt/retroscrappy/lib -type d -name __pycache__ -prune \
+            -exec rm -rf {} + 2> /dev/null || true
+        ;;
+esac
+
+exit 0
